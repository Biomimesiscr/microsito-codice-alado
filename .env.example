# Token público de Mapbox (scope "public"), usado por CollectionMap.
# Sin este valor, CollectionMap degrada a un listado de sitios (ver
# src/components/insect/README.md → "Mapa sin token").
VITE_MAPBOX_TOKEN=

# Widget de anotación visual (@webdots/annotate-client), montado por
# src/components/annotate/AnnotateWidget.tsx. Sin VITE_WEBDOTS_API_URL el
# widget no se monta.
VITE_WEBDOTS_API_URL=
VITE_WEBDOTS_API_KEY=
# Opcional: si se omite el nombre, el widget pide acceso por magic link.
VITE_WEBDOTS_USER_NAME=
VITE_WEBDOTS_USER_EMAIL=
